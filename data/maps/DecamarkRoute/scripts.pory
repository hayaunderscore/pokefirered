mapscripts DecamarkRoute_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: DecamarkRoute_OnTransition
}

script DecamarkRoute_OnTransition {
	setworldmapflag(FLAG_WORLD_MAP_ISLE_6)
}

script DecamarkRoute_EventScript_Sign {
	msgbox("FOREST OF CALM AHEAD", MSGBOX_SIGN)
	normalmsg
	msgbox("A note is appended next to
			the sign\.", MSGBOX_SIGN)
	signmsg
	msgbox("Great job on finding it!
			- ??????????", MSGBOX_SIGN)
	end
}

script DecamarkRoute_EventScript_Rock {
	lock
	msgbox("{PLAYER}, I'm sure you're getting
			sick of the rock jokes by now.")
	release
	end
}
