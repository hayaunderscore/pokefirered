raw `
Route7_EventScript_UndergroundPathSign::
	msgbox Route7_Text_UndergroundPathSign, MSGBOX_SIGN
	end
`

mapscripts Route7_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: Route7_OnTransition
	MAP_SCRIPT_ON_RESUME: Route7_OnResume
}

script Route7_OnResume {
	if (flag(FLAG_SYS_SPECIAL_WILD_BATTLE)) {
		call(Route7_EventScript_RemoveSnorlax)
	}
}

script Route7_OnTransition {
	if (!flag(FLAG_DID_SUNKEN_ANNE)) {
		setflag(FLAG_HIDE_ROUTE_7_SNORLAX)
		setflag(FLAG_HIDE_ROUTE_7_YOUNGSTER)
	}
}

script Route7_EventScript_RemoveSnorlax {
	removeobject(VAR_LAST_TALKED)
}

script Route7_EventScript_Youngster {
	if (flag(FLAG_HIDE_ROUTE_7_SNORLAX)) {
		msgbox("It's gone now!
				Thanks!", MSGBOX_NPC)
	} else {
		msgbox("The folks over at CELADON tried to
				move a SNORLAX out of CYCLING ROAD.

				Well, it's here instead.
				Sucks to suck, I guess.", MSGBOX_NPC)
	}
	end
}

script Route7_EventScript_Snorlax {
	lock
	faceplayer
	if (!flag(FLAG_GOT_POKE_FLUTE)) {
		goto(Route7_EventScript_SnorlaxNoPokeFlute)
	}
	goto_if_questlog(EventScript_ReleaseEnd)
	special(QuestLog_CutRecording)
	msgbox(Text_WantToUsePokeFlute, MSGBOX_YESNO)
	if (var(VAR_RESULT) == FALSE) {
		goto(Route7_EventScript_DontUsePokeFlute)
	}
	call(EventScript_AwakenSnorlax)
	setwildbattle(SPECIES_SNORLAX, 30)
	waitse
	playmoncry(SPECIES_SNORLAX, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	setflag(FLAG_HIDE_ROUTE_7_SNORLAX)
	setflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	dowildbattle
	clearflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	specialvar(VAR_RESULT, GetBattleOutcome)
	if (var(VAR_RESULT) == B_OUTCOME_WON) {
		goto(Route7_EventScript_FoughtSnorlax)
	} elif (var(VAR_RESULT) == B_OUTCOME_RAN) {
		goto(Route7_EventScript_FoughtSnorlax)
	} elif (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
		goto(Route7_EventScript_FoughtSnorlax)
	}
	release
	end
}

script Route7_EventScript_DontUsePokeFlute {
	release
	end
}

script Route7_EventScript_FoughtSnorlax {
	msgbox(Text_SnorlaxReturnedToMountains)
	release
	end
}

script Route7_EventScript_SnorlaxNoPokeFlute {
	msgbox("A POKéMON is sprawled out in
			a deep and comfortable slumber.")
	release
	end
}
