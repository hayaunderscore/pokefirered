mapscripts PokemonTower_SpiralOfDoom_MapScripts {}

script PokemonTower_SpiralOfDoom_EventScript_Jartha {
	trainerbattle_single(TRAINER_CHANNELER_JARTHA, "Where am I?", "Why is it massive in here?!")
	msgbox("This space isn't exactly\.
			\.euclid.", MSGBOX_AUTOCLOSE)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Kathy {
	trainerbattle_single(TRAINER_CHANNELER_KATHY, "Ah!\nSomeone as lost as me!", "Guh!")
	msgbox("The spiral stretches on for
			miles\.", MSGBOX_AUTOCLOSE)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Opal {
	trainerbattle_single(TRAINER_CHANNELER_OPAL, "Your\. blood\.", "YES! YES!\nI'M AWAKE!")
	msgbox("Sorry for the outburst!
			The tower gets to you\.", MSGBOX_AUTOCLOSE)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Nine {
	trainerbattle_single(TRAINER_CHANNELER_NINE, "I can't see\.", "No\. NO!")
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("It would seem she has passed
			out\.", MSGBOX_AUTOCLOSE)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Cary {
	trainerbattle_single(TRAINER_CHANNELER_CARY, "What do you know about time travel?", "Welp.")
	msgbox("The spirits are running amok.

			This has to be the work of a
			truly cunning individual.", MSGBOX_AUTOCLOSE)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Wrana {
	trainerbattle_single(TRAINER_CHANNELER_WRANA, "Guhhhhh\. Grk!", "AAAAAA!\nWhat was that!")
	msgbox("I can feel the disdain the
			spirits have with this place.", MSGBOX_AUTOCLOSE)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Saslona {
	trainerbattle_single(TRAINER_CHANNELER_SASLONA, "This role is too much for me\nto bear!", "Help! Help me!")
	msgbox("Not even ENTEI could save me\.

			Hmm\.? How I even have it?
			What?", MSGBOX_AUTOCLOSE)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Final {
	trainerbattle_single(TRAINER_CHANNELER_FINAL, "I am exhausted.\nLet's get this over with.", "Zzz\.")
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("I wanna go home\.
			I wanna go see my family.", MSGBOX_AUTOCLOSE)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Woman {
	msgbox("This has got to be the most
			unreal visit I've made here.
			Expecting the 6th floor?
			
			This place is too big to fit in
			LAVENDER TOWER anyway!
			Is it an illusion?", MSGBOX_NPC)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Policeman {
	msgbox("I have heard reports about TEAM
			ROCKET in this area.

			Where are they, exactly?", MSGBOX_NPC)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Grandma {
	msgbox("\. \. \.
			\.Water?
			
			I must be seeing things.
			I'm too old for this.", MSGBOX_NPC)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_BaldingMan {
	msgbox("I am in a bit of a pickle.
			I forgot an ESCAPE ROPE.

			I have to make the trek ALL the
			way back! All the way!", MSGBOX_NPC)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Camper {
	msgbox("Hey! You were the kid GISELLE
			courted at POK\eMON TECH!

			I uh, am trying to get out of\.
			this\. mess\.", MSGBOX_NPC)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Daisy {
	lock
	msgbox("DAISY: {PLAYER}!
			What are you doing out here?

			Nevermind that.
			How about you take a rest?")
	fadescreen(FADE_TO_BLACK)
	closemessage
	playfanfare(MUS_HEAL)
	special(HealPlayerParty)
	waitfanfare
	fadescreen(FADE_FROM_BLACK)
	msgbox("DAISY: I feel like I said a way
			line back there\.

			By the way, have you seen
			{RIVAL} around here\.?

			\. \. \.

			Aw\. I was gonna deliver him
			something\.
			
			No, he's fine.
			He told me over the phone!
			His RATICATE is fine too!
			
			\. \. \.
			\. \. \.
			
			We're you\.{PAUSE 30} worried\.?
			
			Don't fret with that {PLAYER}!
			Stay positive!
			\.As positive we can get, atleast.

			I will say, I did see a little
			girl walk in earlier\.
			What was that about?")
	release
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Channeler {
	msgbox("A few minutes ago, a little girl
			walked in with nonchalance.
			Suddenly everything went black.

			And now\.{PAUSE 30} We're here.{PAUSE 30}
			What I dub, {PAUSE 30}\qoSPIRAL OF DOOM\qc.

			Is the girl playing a prank or
			something\.?
			\.either way, very disrespectful.
			
			The spirits are clearly disastisfied
			with how everything is currently\.
			
			What I'm worried about is the
			ABSOLs in this area.
			They're usually in HOENN, no?", MSGBOX_NPC)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_CrushGirl {
	msgbox("All these GHOSTs make me queasy!
			I'm about to blow my nose\.", MSGBOX_NPC)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_WorkerM {
	msgbox("I was gonna deliver something to
			the POK\e MART, but\.
			I ended up here.

			\.{PAUSE 30}
			Welp.", MSGBOX_NPC)
	end
}

script PokemonTower_SpiralOfDoom_EventScript_Giselle {
	msgbox("GISELLE: Mon amour!
			What are you doing here?!

			I tried to get out via the stairs,
			and suddenly, massive room!

			I hope those stairs take us out
			of this mess\.", MSGBOX_NPC)
	end
}
