mapscripts Route28_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: Route28_OnTransition
}

script Route28_OnTransition {
	setworldmapflag(FLAG_WORLD_MAP_ROUTE_28)
	end
}

script Route28_EventScript_MtSilverSign {
	lock
	msgbox("MT. SILVER AHEAD

			CAUTION! VERY COLD!
			Make sure to bring a jacket!")
	release
	end
}
