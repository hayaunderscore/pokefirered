const METATILE_FORGETMENOTS = 0x379

mapscripts CadmiumIsland_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: CadmiumIsland_OnTransition
	MAP_SCRIPT_ON_LOAD: CadmiumIsland_OnLoad
}

// Common script for hiding specific NPCS
script CadmiumIsland_Common_HideNPCS {
	clearflag(FLAG_HIDE_OLD_MAN_NPCS_IN_CADMIUM)
	clearflag(FLAG_HIDE_IKE_NPCS_IN_CADMIUM)
	clearflag(FLAG_HIDE_BILL_NPCS_IN_CADMIUM)
	if (!flag(FLAG_ESSENCE_OLD_MAN)) {
		setflag(FLAG_HIDE_OLD_MAN_NPCS_IN_CADMIUM)
	}
	if (!flag(FLAG_ESSENCE_IKE)) {
		setflag(FLAG_HIDE_IKE_NPCS_IN_CADMIUM)
	}
	if (!flag(FLAG_ESSENCE_BILL)) {
		setflag(FLAG_HIDE_BILL_NPCS_IN_CADMIUM)
	}
	return
}

script CadmiumIsland_OnTransition {
	setflag(FLAG_WORLD_MAP_CADMIUM_ISLAND)
	call(CadmiumIsland_Common_HideNPCS)
	end
}

script CadmiumIsland_OnLoad {
	if (flag(FLAG_ESSENCE_OLD_MAN)) {
		// Add sign
		setmetatile(21, 37, 0x002, TRUE)
		// Add a few forget-me-nots
		setmetatile(15, 36, METATILE_FORGETMENOTS, FALSE)
		setmetatile(21, 36, METATILE_FORGETMENOTS, FALSE)
		setmetatile(16, 38, METATILE_FORGETMENOTS, FALSE)
		setmetatile(20, 38, METATILE_FORGETMENOTS, FALSE)
		setmetatile(28, 32, METATILE_FORGETMENOTS, FALSE)
		setmetatile(32, 32, METATILE_FORGETMENOTS, FALSE)
		// Activate the LEAF FAN CLUB door
		setmetatile(17, 37, 0x30C, TRUE)
	}
	if (flag(FLAG_ESSENCE_IKE)) {
		setmetatile(28, 38, METATILE_FORGETMENOTS, FALSE)
		setmetatile(32, 38, METATILE_FORGETMENOTS, FALSE)
		setmetatile(28, 35, METATILE_FORGETMENOTS, FALSE)
		setmetatile(32, 35, METATILE_FORGETMENOTS, FALSE)
	}
	if (flag(FLAG_ESSENCE_BILL)) {
		setmetatile(16, 30, METATILE_FORGETMENOTS, FALSE)
		setmetatile(18, 30, METATILE_FORGETMENOTS, FALSE)
		setmetatile(17, 29, METATILE_FORGETMENOTS, FALSE)
		setmetatile(19, 29, METATILE_FORGETMENOTS, FALSE)
		setmetatile(30, 32, METATILE_FORGETMENOTS, FALSE)
		setmetatile(30, 35, METATILE_FORGETMENOTS, FALSE)
		// Activate the mysterious door to the other house
		// A sign for this will be revealed at the end...
		setmetatile(17, 28, 0x03D, TRUE)
	}
}

script CadmiumIsland_EventScript_Sign {
	msgbox("CADMIUM ISLAND
			The wonderful paradise", MSGBOX_SIGN)
	release
	end
}

script CadmiumIsland_EventScript_Picnicker {
	lock
	faceplayer
	msgbox("This island is quite peaceful.
			Barely anyone's in it though.

			Maybe the lack of residents at the
			moment makes it like that\.")
	release
	end
}

script CadmiumIsland_EventScript_CooltrainerM {
	lock
	faceplayer
	msgbox("There's quite a fair bit of rare
			POK\eMON here.

			The fact no one has studied them
			boggles my mind!")
	release
	end
}

script CadmiumIsland_EventScript_LeafFanclubSign {
	if (!flag(FLAG_ESSENCE_OLD_MAN)) {
		end
	}
	lock
	msgbox("{PLAYER} FAN CLUB", MSGBOX_SIGN)
	release
	end
}

script CadmiumIsland_EventScript_OldLady {
	lock
	faceplayer
	msgbox("The sea whistles its tune\.
			Can you hear it?

			I hope my other relatives can live
			here with me.")
	release
	end
}

script CadmiumIsland_EventScript_FatMan {
	lock
	faceplayer
	msgbox("Technology is incredible!

			The FAME CHECKER can now store
			more information.")
	release
	end
}

script CadmiumIsland_EventScript_Scientist {
	lock
	faceplayer
	msgbox("Odd things happen in this island.

			You could chalk it up to
			coincidence, but I have never seen
			a consistent location for FEEBAS!

			The fact that this previously
			unknown island has them makes me
			quite confused!")
	release
	end
}

script CadmiumIsland_EventScript_LittleBoy {
	lock
	faceplayer
	msgbox("The sand here is nice!

			It's probably the best sand in
			the entire world!")
	release
	end
}

script CadmiumIsland_EventScript_AbbyEncounter {
	setvar(VAR_MAP_SCENE_CADMIUM_ISLAND_ABBY, 1)
	lock
	applymovement(LOCALID_PLAYER, moves(face_up))
	waitmovement(0)
	fadenewbgm(MUS_DUMMY)
	delay(60)
	setweather(WEATHER_RAIN)
	doweather
	delay(166)
	setweather(WEATHER_NONE)
	doweather
	delay(166)
	setweather(WEATHER_RAIN)
	doweather
	delay(166)
	setweather(WEATHER_NONE)
	doweather
	delay(166)
	setweather(WEATHER_RAIN)
	doweather
	delay(166)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("YOU'RE HERE.")
	closemessage
	setweather(WEATHER_RAIN_THUNDERSTORM)
	doweather
	delay(166)
	msgbox("{COLOR BLUE}I {COLOR RED}HAVE BEEN\.{PAUSE 30}
			EXPECTING YOU.

			WELL. HERE IT IS.
			THE CLIMAX.

			SO\.{PAUSE 30} HI!{PAUSE 30}

			YOU'RE PROBABLY WONDERING WHAT IS
			CURRENTLY HAPPENING RIGHT NOW\.

			BUT DON'T WORRY, {PLAYER}\.
			IT'S NOTHING SERIOUS.

			YOU HAVE DONE WELL TO FIND THE
			SECRETS {COLOR BLUE}I {COLOR RED}HAVE HIDDEN IN THIS
			REALM\.

			AND NOW THAT YOU'RE HERE\.

			THE LAST TASK YOU NEED TO UPHOLD
			CAN FINALLY BEGIN.

			AS A REWARD FOR YOUR CURRENT
			EFFORTS SO FAR\.

			{COLOR BLUE}I{COLOR RED} BESTOW YOU THIS.")
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("{PLAYER} received the THUNDERBADGE
			from !{PAUSE_MUSIC}{PLAY_BGM}{MUS_OBTAIN_BADGE}{PAUSE 0xFE}{PAUSE 0x56}{RESUME_MUSIC}")
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("YOU SHOULD NOW BE ABLE TO FLY.
			BE CAREFUL THOUGH!

			YOU MUST NOT EXPOSE THAT BADGE
			TO THE AIR.

			{COLOR BLUE}I {COLOR RED}WILL NOT OFFER A SECOND ONE IF
			YOU BREAK THIS.

			ATLEAST, RIGHT NOW.
			{COLOR BLUE}MY {COLOR RED}HANDS ARE QUITE TIED :V

			BACK TO THE TOPIC AT QUESTION\.

			YOU MUST FIND THE ANOMALIES 6.

			THEY MUST BE LEFT ALIVE.
			DO NOT USE YOUR MOVE ON THEM.

			{COLOR BLUE}I {COLOR RED}WANT LESS CASUALTIES TO HAPPEN
			THIS TIME. TYVM :3

			{COLOR BLUE}I {COLOR RED}SUGGEST YOU STOP BY AT VIRIDIAN
			CITY.

			YOU KNOW WHO {COLOR BLUE}I'M{COLOR RED} TALKING ABOUT.

			NOW GO!

			RETURN WHEN YOU HAVE TALKED TO
			ALL OF THEM.

			AND USE YOUR DAMN FAMECHECKER!

			NO ONE USES THAT FOR SOME
			REASON\.")
	famechecker(FAMECHECKER_ABBY, 0)
	setflag(FLAG_BADGE03_GET)
	// setflag(FLAG_DEFEATED_LT_SURGE)
	closemessage
	setweather(WEATHER_SUNNY)
	doweather
	delay(166)
	release
	end
}
