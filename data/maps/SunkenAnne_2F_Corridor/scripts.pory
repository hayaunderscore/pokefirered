mapscripts SunkenAnne_2F_Corridor_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: SunkenAnne_2F_Corridor_EventScript_OnTransition
}

script SunkenAnne_2F_Corridor_EventScript_OnTransition {
	clearflag(FLAG_SYS_PREVENT_MAP_FADE)
	setrespawn(HEAL_LOCATION_SUNKEN_ANNE_2F_CORRIDOR)
}

script SunkenAnne_2F_Corridor_EventScript_LockedDoor {
	lock
	delay(16)
	playse(SE_BANG)
	waitse
	msgbox("It won't open.", MSGBOX_SIGN)
	release
	end
}

script SunkenAnne_2F_Room_EventScript_OldMan {
	lock
	faceplayer
	msgbox("Egads! The ship sank!

			Someone like you should definitely
			get out of here as fast as you can.

			Which is why I'm not doing that.")
	release
	end
}

script SunkenAnne_2F_Room_EventScript_BlueTrigger {
	applymovement(LOCALID_PLAYER, moves(
		face_up
	))
	applymovement(LOCALID_SUNKEN_ANNE_BLUE, moves(
		walk_in_place_down
	))
	waitmovement(0)
	playse(SE_PIN)
	applymovement(LOCALID_SUNKEN_ANNE_BLUE, moves(
		emote_exclamation_mark
		delay_16 * 4
		walk_down
		walk_right
		walk_in_place_down
		delay_16
	))
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("{RIVAL}: {PLAYER}!
			You're alright!

			Man, I don't know what happened
			here but we really need to get out
			as soon as possible!

			I was worried you wouldn't\.
			survive\.

			\.

			Well no point in dwelling in that now,
			especially at this time!

			Clearly the law enforcement ain't
			gonna help us, so how about let's
			tag along together?

			Just like\. old times.")
	closemessage
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	message("{RIVAL} will now follow you!")
	waitmessage
	playfanfare(MUS_OBTAIN_BADGE)
	waitfanfare
	loadword(0, BlueFollow)
	setfollower(LOCALID_SUNKEN_ANNE_BLUE, FOLLOWER_FLAG_CUSTOM_FOLLOW_SCRIPT)
	setvar(VAR_MAP_SCENE_SUNKEN_ANNE, 1)
	closemessage
	end
}

script(local) BlueFollow {
	msgbox("{RIVAL}: \.", MSGBOX_SIGN)
	end
}
