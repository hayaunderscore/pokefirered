mapscripts CadmiumIsland_PokemonCenter_1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: CadmiumIsland_PokemonCenter_1F_OnTransition
}

script CadmiumIsland_PokemonCenter_1F_OnTransition {
	setrespawn(HEAL_LOCATION_CADMIUM_ISLAND)
	call(CadmiumIsland_Common_HideNPCS)
	end
}

script CadmiumIsland_PokemonCenter_1F_EventScript_Nurse {
	lock
	faceplayer
	call(EventScript_PkmnCenterNurse)
	release
	end
}

script CadmiumIsland_PokemonCenter_1F_EventScript_Pokemaniac {
	lock
	faceplayer
	msgbox("There are many things we don't know
			about the world.

			One of which is who exactly created
			POK\eMON.

			Is it ARCEUS?
			Is it MEW?

			\.Is it\.{PAUSE 30} THEM?
			{PAUSE 30}Who knows!")
	release
	end
}

script CadmiumIsland_PokemonCenter_1F_EventScript_Youngster {
	lock
	faceplayer
	msgbox("Catching rare POK\eMON is fun!
			This island has loads of them!")
	release
	end
}

script CadmiumIsland_PokemonCenter_1F_EventScript_Woman {
	lock
	faceplayer
	msgbox("This island is located on a
			previously unused patch of land.

			Somehow, it became lived in.")
	release
	end
}
