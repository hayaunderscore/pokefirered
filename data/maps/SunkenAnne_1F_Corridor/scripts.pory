mapscripts SunkenAnne_1F_Corridor_MapScripts {}

script SunkenAnne_1F_Corridor_EventScript_Ashe {
	trainerbattle_single(TRAINER_PICNICKER_ASHE, "Oh goodie!\nA person!", "I'm never getting out of here\.")
	msgbox("I feel like I'm going to be sick\.", MSGBOX_AUTOCLOSE)
	closemessage
	end
}

script SunkenAnne_1F_Corridor_EventScript_Rock {
	trainerbattle_single(TRAINER_FISHERMAN_ROCK, "Wanna see the stuff I hauled in
													this ship?", "Guess its back to fishing!")
	msgbox("Fishing is a good way to distract
			yourself from the horrors.", MSGBOX_AUTOCLOSE)
	closemessage
	end
}

script SunkenAnne_1F_Corridor_EventScript_Vector {
	trainerbattle_single(TRAINER_POKEMANIAC_VECTOR, "Committing crimes in both direction\.
													and magnitude!", "Uh, no!")
	msgbox("Oh yeah!

			\.
			I have nothing else to do here.", MSGBOX_AUTOCLOSE)
	closemessage
	end
}

script SunkenAnne_1F_Corridor_EventScript_Ella {
	trainerbattle_single(TRAINER_LASS_ELLA, "AAAAA! Water!", "I hate this place so much!")
	msgbox("Please let this be over soon.", MSGBOX_AUTOCLOSE)
	closemessage
	end
}

text SunkenAnne_1F_Corridor_Text_Wigglytuff {
	"Tuff\."
}

text SunkenAnne_1F_Corridor_Text_Wigglytuff2 {
	"Tuff!"
}

script SunkenAnne_1F_Corridor_EventScript_Wigglytuff {
	if (var(VAR_MAP_SCENE_SUNKEN_ANNE) == 3) {
		moncryscript(SPECIES_WIGGLYTUFF, SunkenAnne_1F_Corridor_Text_Wigglytuff2)
		release
		end
	}
	moncryscript(SPECIES_WIGGLYTUFF, SunkenAnne_1F_Corridor_Text_Wigglytuff, CRY_MODE_WEAK)
	if (var(VAR_MAP_SCENE_SUNKEN_ANNE) == 2) {
		bufferitemname(STR_VAR_2, ITEM_POKE_DOLL)
		msgbox("Use the {STR_VAR_2} on it?", MSGBOX_YESNO)
		if (var(VAR_RESULT) == TRUE) {
			applymovement(LOCALID_WIGGLYTUFF, moves(
				delay_16
				jump_in_place_down * 2
				delay_16 * 2
			))
			waitmovement(0)
			moncryscript(SPECIES_WIGGLYTUFF, SunkenAnne_1F_Corridor_Text_Wigglytuff2)
			bufferitemname(STR_VAR_2, ITEM_POKE_DOLL)
			msgbox("It seems like it likes the
					{STR_VAR_2}!")
			applymovement(LOCALID_WIGGLYTUFF, moves(
				walk_up
				walk_left
				face_right
			))
			waitmovement(0)
			setvar(VAR_MAP_SCENE_SUNKEN_ANNE, 3)
			setvar(VAR_MAP_SCENE_VERMILION_CITY, 2)
			setvar(VAR_VERMILION_CITY_TICKET_CHECK_TRIGGER, 0)
			setflag(FLAG_HIDE_SS_ANNE)
		}
	}
	release
	end
}
