mapscripts PokemonTech_Basement_Bathroom_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: PokemonTech_Basement_Bathroom_OnTransition
}

script PokemonTech_Basement_Bathroom_OnTransition {
	setflag(FLAG_SYS_FORCE_LOAD_OFFSCREEN_OBJECT)
	setflag(FLAG_HIDE_MIRROR_NPC_IN_POKETECH_BASEMENT)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_GREEN_NORMAL)
	if (defeated(TRAINER_PKMN_TRAINER_GREEN)) {
		setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_GREEN_ALT)
	}
	if (var(VAR_MAP_SCENE_POKEMON_TECH) == 3) {
		clearflag(FLAG_HIDE_MIRROR_NPC_IN_POKETECH_BASEMENT)
	}
}

script PokemonTech_Basement_Bathroom_EventScript_ReflectionOfYourTrueSelf {
	lock
	faceplayer
	getobjectfacingdirection(LOCALID_PLAYER, VAR_TEMP_1)
	switch (var(VAR_TEMP_1)) { // This is fucking UGLY
		case DIR_EAST:
			applymovement(LOCALID_POKETECH_BATHROOM_REFLECTION2, moves(
				face_left
			))
		case DIR_WEST:
			applymovement(LOCALID_POKETECH_BATHROOM_REFLECTION2, moves(
				face_right
			))
		case DIR_NORTH:
			applymovement(LOCALID_POKETECH_BATHROOM_REFLECTION2, moves(
				face_up
			))
	}
	msgbox("Aaah!
			You scared me.

			Sorry for that whole commotion\.
			earlier today.

			\. \. \.

			They say that your reflection shows
			your true self\.

			But why does mine look like that?")
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	applymovement(LOCALID_POKETECH_BATHROOM_REFLECTION2, moves(
		face_original_direction
	))
	waitmovement(0)
	release
	end
}

script PokemonTech_Basement_Bathroom_EventScript_ItsYou {
	lock
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	if (defeated(TRAINER_PKMN_TRAINER_GREEN)) {
		msgbox("Things change\.
				\.but no matter what\.
				It's still you.")
		release
		end
	}
	msgbox("It's you!

			Poke your reflection?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == FALSE) {
		release
		end
	}
	playse(SE_M_LICK)
	waitse
	delay(10)
	mosaicmorph(LOCALID_POKETECH_BATHROOM_REFLECTION, OBJ_EVENT_GFX_GREEN_ALT)
	waitse
	delay(10)
	playbgm(MUS_ENCOUNTER_GYM_LEADER, FALSE)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Wha- hey!
			Watch where you're pointing that!")
	setvar(VAR_FORCE_BATTLE_MUSIC, MUS_BATTLE_REVOLUTION)
	trainerbattle_no_intro(TRAINER_PKMN_TRAINER_GREEN, "Hmm!
														Losing to myself!
														That's a new one.")
	msgbox("GREEN: It's quite amusing talking
			your own reflection\.

			What's your name, other me?

			\. \. \.
			\. \. \.

			Wow.
			How silent of you.

			Are you a silent protagonist of
			a video game or something?

			Thankfully, I can still see your
			trainer card\.

			\. \. \.
			\. \. \.

			{PLAYER}\.?
			Hmm hmm!

			My name is GREEN.
			Quite similar, no?

			I do not know the circumstances of
			how we are both here right now\.

			How about we leave this place
			without telling anyone?")
	release
	end
}
