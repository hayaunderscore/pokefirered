raw `
SSAnne_2F_Corridor_MapScripts::
	.byte 0

SSAnne_2F_Corridor_EventScript_RivalTriggerLeft::
	lockall
	setvar VAR_TEMP_1, 0
	goto SSAnne_2F_Corridor_EventScript_RivalTrigger
	end

SSAnne_2F_Corridor_EventScript_RivalTriggerMid::
	lockall
	setvar VAR_TEMP_1, 1
	goto SSAnne_2F_Corridor_EventScript_RivalTrigger
	end

SSAnne_2F_Corridor_EventScript_RivalTriggerRight::
	lockall
	setvar VAR_TEMP_1, 2
	goto SSAnne_2F_Corridor_EventScript_RivalTrigger
	end

SSAnne_2F_Corridor_EventScript_RivalApproachLeft::
	applymovement LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalApproachLeft
	waitmovement 0
	return

SSAnne_2F_Corridor_EventScript_RivalApproachMid::
	applymovement LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalApproachMid
	applymovement LOCALID_PLAYER, SSAnne_2F_Corridor_Movement_PlayerFaceRivalMid
	waitmovement 0
	return

SSAnne_2F_Corridor_EventScript_RivalApproachRight::
	applymovement LOCALID_PLAYER, SSAnne_2F_Corridor_Movement_PlayerFaceRivalRight
	applymovement LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalApproachRight
	waitmovement 0
	return

SSAnne_2F_Corridor_EventScript_RivalSquirtle::
	trainerbattle_no_intro TRAINER_RIVAL_SS_ANNE_SQUIRTLE, SSAnne_2F_Corridor_Text_RivalDefeat
	return

SSAnne_2F_Corridor_EventScript_RivalBulbasaur::
	trainerbattle_no_intro TRAINER_RIVAL_SS_ANNE_BULBASAUR, SSAnne_2F_Corridor_Text_RivalDefeat
	return

SSAnne_2F_Corridor_EventScript_RivalCharmander::
	trainerbattle_no_intro TRAINER_RIVAL_SS_ANNE_CHARMANDER, SSAnne_2F_Corridor_Text_RivalDefeat
	return

SSAnne_2F_Corridor_EventScript_RivalExitLeft::
	applymovement LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalExitLeft
	waitmovement 0
	return

SSAnne_2F_Corridor_EventScript_RivalExitMid::
	applymovement LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalExitMid
	waitmovement 0
	return

SSAnne_2F_Corridor_EventScript_RivalExitRight::
	applymovement LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalExitRight
	waitmovement 0
	return

SSAnne_2F_Corridor_Movement_PlayerFaceRivalRight::
	delay_16
	delay_16
	delay_16
	delay_16
	walk_in_place_faster_left
	step_end

SSAnne_2F_Corridor_Movement_PlayerFaceRivalMid::
	delay_16
	delay_16
	delay_16
	delay_16
	walk_in_place_faster_left
	step_end

SSAnne_2F_Corridor_Movement_RivalApproachLeft::
	walk_down
	walk_down
	walk_down
	step_end

SSAnne_2F_Corridor_Movement_RivalApproachMid::
	walk_down
	walk_down
	walk_down
	walk_down
	walk_in_place_faster_right
	step_end

SSAnne_2F_Corridor_Movement_RivalApproachRight::
	walk_down
	walk_down
	walk_down
	walk_down
	walk_right
	delay_4
	step_end

SSAnne_2F_Corridor_Movement_RivalExitLeft::
	walk_right
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end

SSAnne_2F_Corridor_Movement_RivalExitMid::
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end

SSAnne_2F_Corridor_Movement_RivalExitRight::
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end

SSAnne_2F_Corridor_EventScript_Sailor::
	msgbox SSAnne_2F_Corridor_Text_ThisShipIsLuxuryLiner, MSGBOX_NPC
	end
`

script SSAnne_2F_Corridor_EventScript_RivalKillThatFuckingRat {
	closemessage
	fadenewbgm(MUS_DUMMY)
	savebgm(MUS_DUMMY)
	setweather(WEATHER_SHADE)
	doweather
	delay(90)
	msgbox("Eh? Something wrong?

		What, are you scared?

		\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.
		\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.

		Hah! Of what, a POKéMON battle?

		Too bad! I'll give you a reason to
		be scared! Come on!

		\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.
		\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.\.

		What's gotten into you?

		Just send out your POKéMON already!")
	trainerbattle_no_intro(
		TRAINER_RIVAL_SS_ANNE_RATICATE, "W-what?

										What\. what was that?

										No! Time-out! Time-out!

										I forfeit!")
}

script SSAnne_2F_Corridor_EventScript_SinkingShip {
	playse(SE_M_HYDRO_PUMP)
	delay(30)
	applymovement(LOCALID_SS_ANNE_RIVAL, moves(
		walk_in_place_fast_down
		emote_exclamation_mark
		delay_16
		delay_16
	))
	applymovement(LOCALID_PLAYER, moves(
		walk_in_place_fast_down
		emote_exclamation_mark
		delay_16
		delay_16
	))
	waitmovement(0)
	msgbox("\.

			Wait\.

			Is the ship sinking?!
			We gotta get out of here!")
	closemessage
	if (var(VAR_TEMP_1) == 0) {
		applymovement(LOCALID_SS_ANNE_RIVAL, moves(
			walk_fast_right
		))
		waitmovement(0)
	}
	applymovement(LOCALID_SS_ANNE_RIVAL, moves(
		walk_fast_down * 7
	))
	waitmovement(0)
	fadescreen(FADE_TO_WHITE)
	delay(30)
	hideobjectat(LOCALID_PLAYER, 0)
	playse(SE_M_EARTHQUAKE)
	waitse
	playse(SE_M_DIVE)
	waitse
	delay(120)
	setflag(FLAG_SYS_PREVENT_MAP_FADE)
	fadescreenspeed(FADE_TO_BLACK, 4)
	delay(30)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("\.

			It would seem you have met an
			unfortunate fate,{PAUSE 30} haven't you?

			That doesn't mean it's the end,
			however.

			After all, {PAUSE 30}all of this\.

			Is {COLOR BLUE}her{COLOR DARK_GRAY} scenario.

			You wouldn't want your star performer
			to suddenly die now, {PAUSE 30}would you?

			So {PLAYER}\.

			Wake up.")
	releaseall
	showobjectat(LOCALID_PLAYER, 0)
	setflag(FLAG_SUNKEN_ANNE)
	warpsilent(MAP_SUNKEN_ANNE_2F_CORRIDOR, 0)
}

script SSAnne_2F_Corridor_EventScript_RivalTrigger {
	textcolor(NPC_TEXT_COLOR_MALE)
	playse(SE_EXIT)
	delay(5)
	playbgm(MUS_ENCOUNTER_RIVAL, 0)
	addobject(LOCALID_SS_ANNE_RIVAL)
	delay(10)
	applymovement(LOCALID_SS_ANNE_RIVAL, Common_Movement_WalkInPlaceFasterDown)
	waitmovement(0)
	delay(20)
	switch (var(VAR_TEMP_1)) {
		case 0:
			call(SSAnne_2F_Corridor_EventScript_RivalApproachLeft)
			break
		case 1:
			call(SSAnne_2F_Corridor_EventScript_RivalApproachMid)
			break
		case 2:
			call(SSAnne_2F_Corridor_EventScript_RivalApproachRight)
			break
	}
	msgbox(SSAnne_2F_Corridor_Text_RivalIntro)
	setvar(VAR_LAST_TALKED, LOCALID_SS_ANNE_RIVAL)
	if (checkpartymove(MOVE_ABYSS) != PARTY_SIZE || checkpartymove(MOVE_RAPTURE) != PARTY_SIZE || checkpartymove(MOVE_STRIKE) != PARTY_SIZE) {
		call(SSAnne_2F_Corridor_EventScript_RivalKillThatFuckingRat)
		playbgm(MUS_DUMMY, 0)
		closemessage
		delay(10)
		if (flag(FLAG_PROCEEDED_ROUTE)) {
			msgbox("\.

					I\.

					G-get away from me! What did you do
					to your POKéMON?

					What did you do to MY POKéMON?

					I\.

					I have to go!")
			closemessage
			call(SSAnne_2F_Corridor_EventScript_SinkingShip)
		} elif (flag(FLAG_FLAWED_ROUTE)) {
			msgbox("\.

					{PLAYER}\.

					Are you okay?", MSGBOX_YESNO)
			if (var(VAR_RESULT) == TRUE) {
				msgbox("\.Sure.

						Just\. needed to ask.

						You seem quite out of it these days
						for\. some reason.

						I'll get out of your hair.")
			} else {
				msgbox("\.

						I-I'm sorry\.

						I'll let you be.")
			}
			closemessage
			switch (var(VAR_TEMP_1)) {
				case 0:
					call(SSAnne_2F_Corridor_EventScript_RivalExitLeft)
					break
				case 1:
					call(SSAnne_2F_Corridor_EventScript_RivalExitMid)
					break
				case 2:
					call(SSAnne_2F_Corridor_EventScript_RivalExitRight)
					break
			}
		}
	}
	else {
		switch (var(VAR_STARTER_MON)) {
			case 0:
				call(SSAnne_2F_Corridor_EventScript_RivalCharmander)
				break
			case 1:
				call(SSAnne_2F_Corridor_EventScript_RivalBulbasaur)
				break
			case 2:
				call(SSAnne_2F_Corridor_EventScript_RivalSquirtle)
				break
		}
		closemessage
		delay(10)
		playbgm(MUS_RIVAL_EXIT, 0)
		switch (var(VAR_TEMP_1)) {
			case 0:
				call(SSAnne_2F_Corridor_EventScript_RivalExitLeft)
				break
			case 1:
				call(SSAnne_2F_Corridor_EventScript_RivalExitMid)
				break
			case 2:
				call(SSAnne_2F_Corridor_EventScript_RivalExitRight)
				break
		}
		fadedefaultbgm
	}
	removeobject(LOCALID_SS_ANNE_RIVAL)
	setvar(VAR_MAP_SCENE_S_S_ANNE_2F_CORRIDOR, 1)
	releaseall
	end
}
